// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=wr_1789445789301205802 @name=mpv fullscreen
window-rule {
    match app-id="^mpv$"
    open-fullscreen true
}

// @id=wr_1790817948861571446 @name=firefox$
window-rule {
    match app-id="firefox$"
    match app-id="kitty"
    match app-id="^google-chrome$"
    open-maximized true
}
