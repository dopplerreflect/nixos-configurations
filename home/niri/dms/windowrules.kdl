// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1789445789301205802 @name=mpv fullscreen
window-rule {
    match app-id="^mpv$"
    open-fullscreen true
}

// @id=wr_1790817948861571446 @name=Maximize
window-rule {
    match app-id="firefox$"
    match app-id="kitty"
    match app-id="^google-chrome$"
    match app-id="^orca-slicer$"
    match app-id="^org.freecad.FreeCAD$"
    match app-id="^FreeCAD$"
    open-maximized true
}

// @id=wr_1794514562909500767 @name=Load Clock Window
window-rule {
    match app-id="^chrome-fhndgjphicgdlodikegejijmhegkhhdc-Default$"
    open-floating true
    min-width 500
    max-width 500
    min-height 800
    max-height 800
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
