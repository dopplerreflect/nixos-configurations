// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1789445789301205802 @name=mpv fullscreen
window-rule {
    match app-id="^mpv$"
    open-fullscreen true
}

// @id=wr_1790817948861571446 @name=Maximize
window-rule {
    match app-id="firefox$"
    match app-id="kitty"
    match app-id="^google-chrome$"
    open-maximized true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
